# Copy this file to .env and customize the values.
# DO NOT commit your real secrets; .env is gitignored.

# CSRF secret key (32+ random bytes). Example generation (Linux/macOS):
# openssl rand -base64 32
CSRF_AUTH_KEY=REPLACE_WITH_BASE64_32_BYTE_SECRET

# Optional runtime paths/listeners; defaults keep development working.
# KITTY_HTTP_ADDR=127.0.0.1:6835
# KITTY_GEMINI_ADDR=127.0.0.1:19666
# KITTY_DB_PATH=kitty.db
# KITTY_GEMINI_CERT=cert/gemini_cert.pem
# KITTY_GEMINI_KEY=cert/gemini_key.pem
# Set both guards to true for an existing managed production installation.
# KITTY_REQUIRE_DATABASE=false
# KITTY_REQUIRE_TLS=false
